# Variables de Entorno - Control IT
# Copia este archivo a .env y completa los valores

# Django
SECRET_KEY=django-insecure-cambia-esta-clave-por-una-segura-de-50-caracteres
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de Datos PostgreSQL
# Formato: postgres://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgres://control_it_user:tu_password@localhost:5432/control_it_db

# Opcional: Para desarrollo rápido con SQLite (descomenta y comenta DATABASE_URL de arriba)
# DATABASE_URL=sqlite:///db.sqlite3

# Configuración de Email (opcional - para alertas/notificaciones)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-email@gmail.com
# EMAIL_HOST_PASSWORD=tu-app-password
# DEFAULT_FROM_EMAIL=Control IT <noreply@controlit.local>

# Configuración de Archivos Estáticos/Media (opcional - para producción con AWS S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_CUSTOM_DOMAIN=

# Configuración de Caché (opcional - Redis)
# CACHE_URL=redis://localhost:6379/1

# Configuración de Logging (opcional)
# LOG_LEVEL=INFO